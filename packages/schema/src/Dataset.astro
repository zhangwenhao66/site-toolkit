---
import { jsonLdStringify } from './jsonLdStringify';

interface Creator {
	'@type': 'Organization' | 'Person';
	name: string;
	url?: string;
}

interface Props {
	name: string;
	description?: string;
	url?: string;
	license?: string;
	temporalCoverage?: string;
	spatialCoverage?: string;
	creator?: Creator;
}

const { name, description, url, license, temporalCoverage, spatialCoverage, creator } = Astro.props;

const data = {
	'@context': 'https://schema.org',
	'@type': 'Dataset',
	name,
	...(description ? { description } : {}),
	...(url ? { url } : {}),
	...(license ? { license } : {}),
	...(temporalCoverage ? { temporalCoverage } : {}),
	...(spatialCoverage ? { spatialCoverage } : {}),
	...(creator ? { creator } : {}),
};
---

<script type="application/ld+json" set:html={jsonLdStringify(data)} />
