---
import { jsonLdStringify } from './jsonLdStringify';

interface Props {
	name: string;
	url: string;
	logo?: string;
	sameAs?: string[];
	description?: string;
	email?: string;
	knowsAbout?: string[];
}

const { name, url, logo, sameAs, description, email, knowsAbout } = Astro.props;

const data = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name,
	url,
	...(logo
		? {
				logo: {
					'@type': 'ImageObject',
					url: logo,
				},
			}
		: {}),
	...(sameAs && sameAs.length > 0 ? { sameAs } : {}),
	...(description ? { description } : {}),
	...(email
		? {
				contactPoint: [
					{
						'@type': 'ContactPoint',
						contactType: 'customer support',
						email,
					},
				],
			}
		: {}),
	...(knowsAbout && knowsAbout.length > 0 ? { knowsAbout } : {}),
};
---

<script type="application/ld+json" set:html={jsonLdStringify(data)} />
