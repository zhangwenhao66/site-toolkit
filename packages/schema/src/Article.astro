---
import { jsonLdStringify } from './jsonLdStringify';

interface Props {
	headline: string;
	description?: string;
	datePublished: string;
	dateModified?: string;
	authorName: string;
	authorUrl?: string;
	image?: string;
	/** 2026-08-27：图片搜索占矩阵总曝光 24.6%（UmberLore 达 60%），但此前 schema 只给裸 URL。
	 *  补 ImageObject 的宽高与说明，是图片搜索最直接的结构化信号。三者可选，缺了就退回裸 URL。 */
	imageWidth?: number;
	imageHeight?: number;
	imageCaption?: string;
	url: string;
	/** 2026-10-12：Google 建议 Article 标注 publisher（全站 check-schema 报 "missing recommended: publisher"）。
	 *  publisher 与页面上的品牌 Organization 节点指同一实体，用 publisherId 以 @id 引用，避免重复定义。 */
	publisherName?: string;
	publisherUrl?: string;
	publisherLogo?: string;
	publisherId?: string;
}

const { headline, description, datePublished, dateModified, authorName, authorUrl, image, imageWidth, imageHeight, imageCaption, url,
	publisherName, publisherUrl, publisherLogo, publisherId } =
	Astro.props;

const data = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline,
	...(description ? { description } : {}),
	datePublished,
	...(dateModified ? { dateModified } : {}),
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	author: {
		'@type': 'Organization',
		name: authorName,
		...(authorUrl ? { url: authorUrl } : {}),
	},
	...(publisherName
		? {
				publisher: {
					'@type': 'Organization',
					...(publisherId ? { '@id': publisherId } : {}),
					name: publisherName,
					...(publisherUrl ? { url: publisherUrl } : {}),
					...(publisherLogo
						? { logo: { '@type': 'ImageObject', url: publisherLogo } }
						: {}),
				},
			}
		: {}),
	...(image
		? {
				image: [
					imageWidth && imageHeight
						? {
								'@type': 'ImageObject',
								url: image,
								width: imageWidth,
								height: imageHeight,
								...(imageCaption ? { caption: imageCaption } : {}),
							}
						: image,
				],
			}
		: {}),
};
---

<script type="application/ld+json" set:html={jsonLdStringify(data)} />
